# Copy to .env (locally) or .env on the server. NEVER commit real values.

# ─── API auth ───
# Random 32+ char token. Clients pass it as: Authorization: Bearer <API_KEY>
API_KEY=replace-me-with-random-32+-chars

# ─── Database ───
POSTGRES_HOST=postgres            # 'postgres' when running via docker-compose
POSTGRES_PORT=5432
POSTGRES_DB=fotoklass
POSTGRES_USER=fotoklass
POSTGRES_PASSWORD=replace-me

# ─── RunPod ───
RUNPOD_API_KEY=rpa_xxxxxxxxxxxx
RUNPOD_RTX4090_PER_HOUR=0.34

# ─── Hetzner Object Storage (S3) ───
HETZNER_S3_ENDPOINT=https://hel1.your-objectstorage.com
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=
HETZNER_S3_REGION=
HETZNER_S3_BUCKET=

# ─── Tariffs ───
HETZNER_OBJECT_STORAGE_PER_GB=0.01
HETZNER_EGRESS_PER_TB=1.00
VPS_PER_MONTH=10
